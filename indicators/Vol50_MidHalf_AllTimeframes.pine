//@version=6
indicator("Vol50 Reversal / All Timeframes / MID Half",overlay=true,max_lines_count=500,max_labels_count=500,max_bars_back=1500)
// All timeframes: chart-bar deadlines. Volume50 peak arms search; last5 bars define SL.
// Optional historical ML weights are applied ONLY on15m, never transferred to other timeframes.
// Fees used in Python: round-trip0.04%, slip0.01%/fill, PRICE reward/risk2.
// Indicator tracks independent lots; never replaces another lot's stop/target.
useML=input.bool(false,"Optional OLD ML: 15-minute chart ONLY")
longThreshold=input.float(.20,"Long: new-model threshold",minval=0,maxval=1,step=.05)
shortThreshold=input.float(.30,"Short: new-model threshold",minval=0,maxval=1,step=.05)
wickMin=input.float(.40,"Rejection wick / range (long lower, short upper)",minval=0,maxval=1,step=.05)
dojiMax=input.float(.10,"Max opposite-color doji body / range",minval=0,maxval=1,step=.05)
volumeLookback=input.int(50,"Volume peak: trailing candles INCLUDING current",minval=2)
scanBars=input.int(10,"Max bars: FIRST volume peak to actual entry",minval=2,maxval=10)
stopBars=input.int(5,"SL: signal candle INCLUDED trailing candles",minval=1)
startTime=input.time(0,"Entry signals start (all history by default)")
slip=input.float(.01,"Slippage per fill %",minval=0)/100
// Entry deadlines use observed CHART BARS, not a fixed15-minute clock.
validTF=true
mlTimeframe=timeframe.isminutes and timeframe.multiplier==15
mlActive=useML and mlTimeframe
// A tied maximum qualifies. First rank-1 transition starts a fixed, nonrefreshing window.
peakValue=ta.highest(volume,volumeLookback)
peak50=bar_index>=volumeLookback-1 and volume>0 and volume>=peakValue
peakEvent=peak50 and not peak50[1]
var int volumeAnchor=na
bool volumeArmedNow=false
if barstate.isconfirmed and validTF
    if not na(volumeAnchor) and bar_index-volumeAnchor>=scanBars
        volumeAnchor:=na
    if na(volumeAnchor) and peakEvent
        volumeAnchor:=bar_index
        volumeArmedNow:=true
// No entry on peak candle. Reserve one bar for NEXT-open entry.
volumeContext=not na(volumeAnchor) and bar_index>=volumeAnchor and bar_index-volumeAnchor<scanBars
volumeScan=volumeContext and bar_index>volumeAnchor

// The next observed chart candle is the execution candle, even after a session gap.
contiguous=bar_index>0
tr=ta.tr(true)
atr=ta.rma(tr,20)
atr14=ta.rma(tr,14)
atr100=ta.rma(tr,100)
low100=ta.lowest(low,100)
high100=ta.highest(high,100)
span100=high100-low100
rng=high-low
f_div(float a,float b) =>
    b!=0 ? a/b : na
body=f_div(close-open,rng)
lowerWick=f_div(math.min(open,close)-low,rng)
upperWick=f_div(high-math.max(open,close),rng)
closeLocation=f_div(close-low,rng)
volumeRatio20=f_div(volume,ta.sma(volume,20)[1])
ema10=ta.ema(close,10)
ema20=ta.ema(close,20)
ema50=ta.ema(close,50)
ema100=ta.ema(close,100)
delta=ta.change(close)
u14=ta.rma(math.max(delta,0),14)
d14=ta.rma(math.max(-delta,0),14)
u30=ta.rma(math.max(delta,0),30)
d30=ta.rma(math.max(-delta,0),30)
f_rsi(float u,float d) =>
    u==0 and d==0 ? 50.0 : d==0 ? 100.0 : 100-100/(1+u/d)
rsi14=f_rsi(u14,d14)
rsi30=f_rsi(u30,d30)
stoch14=f_div(close-ta.lowest(low,14),ta.highest(high,14)-ta.lowest(low,14))
upMove=ta.change(high)
downMove=-ta.change(low)
plusDM=upMove>downMove and upMove>0 ? upMove : 0.0
minusDM=downMove>upMove and downMove>0 ? downMove : 0.0
diPlus=f_div(100*ta.rma(plusDM,14),atr14)
diMinus=f_div(100*ta.rma(minusDM,14),atr14)
adx14=ta.rma(f_div(100*math.abs(diPlus-diMinus),diPlus+diMinus),14)
// Oldest tie wins, matching numpy.argmin/argmax on the previous100 candles.
int lowAge=100
int highAge=100
float oldLow=low[100]
float oldHigh=high[100]
int lowTouches=0
int highTouches=0
if bar_index>=100
    for j=99 to 1
        if low[j]<oldLow
            oldLow:=low[j]
            lowAge:=j
        if high[j]>oldHigh
            oldHigh:=high[j]
            highAge:=j
    for j=0 to 99
        lowTouches+=low[j]<=low100+.25*atr ? 1 : 0
        highTouches+=high[j]>=high100-.25*atr ? 1 : 0

// Same64 feature definitions and exported scaler/logistic coefficients.
x0=f_div(close-low100,span100) // position100
x1=f_div(close-low100,atr) // low_distance_atr
x2=f_div(high100-close,atr) // high_distance_atr
x3=f_div(low-low100,atr) // low_wick_distance_atr
x4=f_div(high100-high,atr) // high_wick_distance_atr
x5=f_div(span100,atr) // range100_atr
x6=f_div(ta.highest(high,20)-ta.lowest(low,20),span100) // range20_to100
x7=f_div(ta.highest(high,5)-ta.lowest(low,5),ta.highest(high,20)-ta.lowest(low,20)) // range5_to20
x8=low<=ta.lowest(low,100)[1] ? 1.0 : 0.0 // new_low100
x9=high>=ta.highest(high,100)[1] ? 1.0 : 0.0 // new_high100
x10=body // body_fraction
x11=lowerWick // lower_wick_fraction
x12=upperWick // upper_wick_fraction
x13=closeLocation // close_location
x14=f_div(rng,atr) // range_atr
x15=f_div(close-open,atr) // body_atr
x16=f_div(open-close[1],atr) // gap_atr
x17=f_div(close-close[1],atr) // return1_atr
x18=f_div(close-close[3],atr) // return3_atr
x19=f_div(close-close[5],atr) // return5_atr
x20=f_div(close-close[10],atr) // return10_atr
x21=f_div(close-close[20],atr) // return20_atr
x22=f_div(close-close[50],atr) // return50_atr
x23=f_div(close-close[100],atr) // return100_atr
x24=ta.sma(close>open ? 1.0 : 0.0,3) // bull_fraction3
x25=ta.sma(lowerWick,3) // lower_wick_mean3
x26=ta.sma(upperWick,3) // upper_wick_mean3
x27=ta.sma(close>open ? 1.0 : 0.0,10) // bull_fraction10
x28=ta.sma(lowerWick,10) // lower_wick_mean10
x29=ta.sma(upperWick,10) // upper_wick_mean10
x30=ta.sma(close>open ? 1.0 : 0.0,20) // bull_fraction20
x31=ta.sma(lowerWick,20) // lower_wick_mean20
x32=ta.sma(upperWick,20) // upper_wick_mean20
x33=f_div(close-ema10,atr) // ema10_distance_atr
x34=f_div(ema10-ema10[5],atr) // ema10_slope5_atr
x35=f_div(close-ema20,atr) // ema20_distance_atr
x36=f_div(ema20-ema20[5],atr) // ema20_slope5_atr
x37=f_div(close-ema50,atr) // ema50_distance_atr
x38=f_div(ema50-ema50[5],atr) // ema50_slope5_atr
x39=f_div(close-ema100,atr) // ema100_distance_atr
x40=f_div(ema100-ema100[5],atr) // ema100_slope5_atr
x41=f_div(atr,atr100) // atr20_to100
x42=f_div(atr,atr[5])-1 // atr_growth5
x43=rsi14 // rsi14
x44=rsi14-rsi14[3] // rsi14_change3
x45=rsi30 // rsi30
x46=rsi30-rsi30[3] // rsi30_change3
x47=stoch14 // stoch14
x48=stoch14-stoch14[3] // stoch14_change3
x49=diPlus-diMinus // di_difference
x50=adx14 // adx14
x51=adx14-adx14[3] // adx14_change3
x52=f_div(ta.lowest(low,20)-ta.lowest(low,80)[20],atr) // higher_low20_atr
x53=f_div(ta.highest(high,80)[20]-ta.highest(high,20),atr) // lower_high20_atr
x54=volumeRatio20 // volume_ratio20
x55=f_div(volume,ta.sma(volume,100)[1]) // volume_ratio100
x56=f_div(ta.sma(volume,3),ta.sma(volume,10)[3]) // volume_change3
x57=f_div(math.sum(f_div(2*close-high-low,rng)*volume,20),math.sum(volume,20)) // signed_volume20
x58=float(lowAge) // previous_low_age
x59=float(highAge) // previous_high_age
x60=rsi14-rsi14[lowAge] // rsi_vs_previous_low
x61=rsi14-rsi14[highAge] // rsi_vs_previous_high
x62=float(lowTouches) // low_touch_count100
x63=float(highTouches) // high_touch_count100
low5=ta.lowest(low,stopBars)
high5=ta.highest(high,stopBars)
signalMid=ta.sma(close,49)
midTouch=signalMid[1]
bbMiddle=ta.sma(close,50)
int anchorAge=na(volumeAnchor) ? 0 : bar_index-volumeAnchor
x64=volumeScan ? float(anchorAge) : na
x65=volumeScan ? f_div(volume,volume[anchorAge]) : na
x66L=f_div(signalMid-close,atr)
x66S=-x66L
x67L=f_div(close-low5,atr)
x67S=f_div(high5-close,atr)
x68L=(signalMid-close)/math.max(2*(close-low5),0.000000001)
x68S=(close-signalMid)/math.max(2*(high5-close),0.000000001)
f_term(float value,float fill,float weight,float missingWeight) =>
    nz(value,fill)*weight+(na(value) ? missingWeight : 0)
float logitL=-0.044127208885699876
logitL+=f_term(x0,0.16290885805943983,0.61800211696815233,0)
logitL+=f_term(x1,1.5096097084548412,0.065918222186314337,0)
