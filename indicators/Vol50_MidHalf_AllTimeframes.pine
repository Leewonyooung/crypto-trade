logitS+=f_term(x61,-2.4829369766608749,-0.0041426962545296694,0)
logitS+=f_term(x62,2.0336879432624113,0.077506481595512891,0)
logitS+=f_term(x63,1.5762411347517731,0.11165113437335118,0)
logitS+=f_term(x64,4.5975177304964543,-0.027061926090698993,0)
logitS+=f_term(x65,0.66421744185160014,0.076350278969475743,0)
logitS+=f_term(x66S,3.6664443462974878,-0.012770851244981389,0)
logitS+=f_term(x67S,1.3146698735619442,0.076430715300591506,0)
logitS+=f_term(x68S,1.6711393933575269,-0.058185878662719903,0)
scoreS=1/(1+math.exp(-math.max(-60,math.min(60,logitS))))
modelTimeOK=not mlActive or time>=1767225600000
longCandidate=f_div(low-low100,atr)<=1 and f_div(close-low100,span100)<=.35
shortCandidate=f_div(high100-high,atr)<=1 and f_div(close-low100,span100)>=.65
longPattern=lowerWick>=wickMin and (close>open or math.abs(body)<=dojiMax)
shortPattern=upperWick>=wickMin and (close<open or math.abs(body)<=dojiMax)
requiredBars=mlActive ? 500 : math.max(99,volumeLookback-1)
baseReady=validTF and volumeScan and bar_index>=requiredBars and time>=startTime and modelTimeOK
longBase=baseReady and longCandidate and longPattern
shortBase=baseReady and shortCandidate and shortPattern
le=open*(1+slip)
se=open*(1-slip)
volumeEntryOK=not na(volumeAnchor[1]) and bar_index-volumeAnchor[1]<=scanBars
// Previous candidate's next-open feasibility is KNOWN now, for causal threshold crossing.
previousLongAdmitted=longBase[1] and contiguous and volumeEntryOK and le>low5[1] and midTouch>le
longConfirm=barstate.isconfirmed and longBase and (not mlActive or scoreL>=longThreshold and not (previousLongAdmitted and scoreL[1]>=longThreshold))
shortConfirm=barstate.isconfirmed and shortBase and (not mlActive or scoreS>=shortThreshold)
buy=validTF and contiguous and volumeEntryOK and longConfirm[1] and le>low5[1] and midTouch>le
sell=validTF and contiguous and volumeEntryOK and shortConfirm[1] and se<high5[1] and midTouch<se
var array<int> dirs=array.new_int()
var array<float> entries=array.new_float()
var array<float> stops=array.new_float()
var array<float> targets=array.new_float()
var array<float> remains=array.new_float()
var array<line> elines=array.new_line()
var array<line> slines=array.new_line()
var array<line> tlines=array.new_line()
var array<label> labels=array.new_label()
f_add(int dir,float ep,float stop,float score) =>
    tp=ep+dir*2*math.abs(ep-stop)
    array.push(dirs,dir)
    array.push(entries,ep)
    array.push(stops,stop)
    array.push(targets,tp)
    array.push(remains,1.0)
    array.push(elines,line.new(bar_index,ep,bar_index+1,ep,color=color.blue))
    array.push(slines,line.new(bar_index,stop,bar_index+1,stop,color=color.red))
    array.push(tlines,line.new(bar_index,tp,bar_index+1,tp,color=color.green))
    array.push(labels,label.new(bar_index,ep,(dir==1 ? "LONG" : "SHORT")+" #"+str.tostring(bar_index)+"\nE "+str.tostring(ep,format.mintick)+"\nSL "+str.tostring(stop,format.mintick)+"\nTP2 "+str.tostring(tp,format.mintick)+(na(score) ? "\nCandle rules" : "\nScore "+str.tostring(score,"#.000")),style=dir==1 ? label.style_label_up : label.style_label_down,color=dir==1 ? color.green : color.red,textcolor=color.white))
if buy
    f_add(1,le,low5[1],mlActive ? scoreL[1] : na)
if sell
    f_add(-1,se,high5[1],mlActive ? scoreS[1] : na)
bool halfThisBar=false
// Confirmed-OHLC visualization; touches fill at their LEVEL, not at candle close.
// It cannot recover unknown intrabar chronology; SL-first except opening events.
if barstate.isconfirmed and array.size(dirs)>0
    for k=array.size(dirs)-1 to 0
        dir=array.get(dirs,k)
        ep=array.get(entries,k)
        stop=array.get(stops,k)
        tp=array.get(targets,k)
        rem=array.get(remains,k)
        lab=array.get(labels,k)
        line.set_x2(array.get(elines,k),bar_index+1)
        line.set_x2(array.get(slines,k),bar_index+1)
        line.set_x2(array.get(tlines,k),bar_index+1)
        midOK=rem>.5 and not na(midTouch) and dir*(midTouch-ep)>0 and dir*(tp-midTouch)>0
        gapSL=dir*(open-stop)<=0
        gapTP=dir*(open-tp)>=0
        gapMID=midOK and dir*(open-midTouch)>=0
        slHit=dir==1 ? low<=stop : high>=stop
        tpHit=dir==1 ? high>=tp : low<=tp
        midHit=midOK and (dir==1 ? high>=midTouch : low<=midTouch)
        bool doHalf=false
        bool exitNow=false
        bool finalTP=false
        if gapSL
            exitNow:=true
        else
            if gapMID
                doHalf:=true
                rem:=.5
            if gapTP
                exitNow:=true
                finalTP:=true
            else if slHit
                exitNow:=true
            else
                if rem>.5 and midHit
                    doHalf:=true
                    rem:=.5
                if tpHit
                    exitNow:=true
                    finalTP:=true
        if doHalf
            halfThisBar:=true
            array.set(remains,k,.5)
            label.set_text(lab,label.get_text(lab)+"\n50% MID "+str.tostring(midTouch,format.mintick))
            line.new(bar_index,midTouch,bar_index+1,midTouch,color=color.orange,width=3)
        if exitNow
            label.set_text(lab,label.get_text(lab)+(rem<1 ? "\nREST " : "\nFULL ")+(finalTP ? "TP2" : "SL"))
            array.remove(dirs,k)
            array.remove(entries,k)
            array.remove(stops,k)
            array.remove(targets,k)
            array.remove(remains,k)
            array.remove(elines,k)
            array.remove(slines,k)
            array.remove(tlines,k)
            array.remove(labels,k)
plot(bbMiddle,"BB50 current closing middle",color=color.gray)
plot(midTouch,"Causal intrabar middle-touch level",color=color.orange,style=plot.style_stepline)
plot(low100,"100bar low",color=color.new(color.green,65))
plot(high100,"100bar high",color=color.new(color.red,65))
plotshape(volumeArmedNow,title="Volume50: arm",text="VOL",style=shape.diamond,location=location.belowbar,color=color.purple,size=size.tiny)
bgcolor(volumeScan ? color.new(color.purple,93) : na)
plotshape(buy,title="Long entry",text="L",style=shape.triangleup,location=location.belowbar,color=color.lime,size=size.small)
plotshape(sell,title="Short entry",text="S",style=shape.triangledown,location=location.abovebar,color=color.red,size=size.small)
plot(mlActive ? scoreL : na,"Long new-model score",display=display.data_window)
plot(mlActive ? scoreS : na,"Short new-model score",display=display.data_window)
plot(array.size(dirs),"Independent open lots",display=display.data_window)
alertcondition(buy,"Long entry","Symmetric Vol50 LONG: independent SL/TP")
alertcondition(sell,"Short entry","Symmetric Vol50 SHORT: independent SL/TP")
alertcondition(halfThisBar,"MID50 half (confirmed-OHLC visualization)","MID50 half event confirmed; see own remaining lot SL/TP")

var table modeStatus=table.new(position.top_right,1,1)
if barstate.islast
    text=bar_index<requiredBars ? "Need more candles: "+str.tostring(requiredBars+1) : mlActive ? "OLD15m ML | "+timeframe.period : "Candle rules | "+timeframe.period
    if useML and not mlTimeframe
        text+="\n15m ML disabled on this timeframe"
    table.cell(modeStatus,0,0,text,text_color=color.white,bgcolor=color.new(color.black,25))
